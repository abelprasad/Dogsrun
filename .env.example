# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase — https://supabase.com/dashboard/project/tnaddnxudfegrsbpgfwq/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — https://resend.com/api-keys (sender is alerts@dogsrun.org)
RESEND_API_KEY=

# Upstash Redis — rate limiting on /api/contact and /api/register.
# Optional locally: the rate limiter no-ops gracefully when these are unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry — error monitoring. Optional locally, required in Vercel Production/Preview.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=dogsrun
SENTRY_PROJECT=dogsrun
SENTRY_AUTH_TOKEN=
